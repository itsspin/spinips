	<!-- 	No respawn dynamic zone loot bonus progress tracker screen -->
	<Label item="TO_NoRespawnTitle">
		<ScreenID>TO_NoRespawnTitle</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Style_Transparent>true</Style_Transparent>
		<Location>
			<X>2</X>
			<Y>2</Y>
		</Location>
		<Size>
			<CX>200</CX>
			<CY>16</CY>
		</Size>
		<Font>3</Font>
		<Text>Zone completion progress:</Text>
		<TooltipReference>Tracks requirements for receiving the zone clear bonus.</TooltipReference>
		<AlignCenter>false</AlignCenter>
		<AlignRight>false</AlignRight>
		<FontShadow>true</FontShadow>		
	</Label>	

