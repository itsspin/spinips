			<Background>A_GaugeBackgroundDark</Background>
		</GaugeDrawTemplate>
		<Location>
			<X>2</X>
			<Y>19</Y>
		</Location>
		<Size>
			<CX>150</CX>
			<CY>12</CY>
		</Size>
	</Gauge>

